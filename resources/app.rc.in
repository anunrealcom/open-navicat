#include <windows.h>

IDI_ICON1 ICON "@DATAMG_ICON_PATH@"

/* Per-Monitor V2 DPI 感知清单（24 = RT_MANIFEST，windres 以构建目录为工作目录） */
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "YihuanTech"
            VALUE "FileDescription", "DataMG 数据库管理工具"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "DataMG"
            VALUE "LegalCopyright", "Copyright (C) 2026 YihuanTech"
            VALUE "OriginalFilename", "DataMG.exe"
            VALUE "ProductName", "DataMG"
            VALUE "ProductVersion", "1.0.0.0"
        END
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "YihuanTech"
            VALUE "FileDescription", "DataMG Database Manager"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "DataMG"
            VALUE "LegalCopyright", "Copyright (C) 2026 YihuanTech"
            VALUE "OriginalFilename", "DataMG.exe"
            VALUE "ProductName", "DataMG"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200, 0x409, 1200
    END
END
